}

/* --- Bouton --- */
.btn-more {
    background: rgba(255, 255, 255, 0.15); /* Légèrement plus opaque */
    border: 1px solid rgba(197, 166, 124, 0.3); /* Bordure dorée mais très transparente par défaut */    color: #fff;
    padding: 8px 18px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-more:hover {
    background: var(--text-gold);
    color: #0d0e0a; /* Le texte passe en noir/sombre pour être lisible sur le fond gold */
    border-color: var(--text-gold);
    box-shadow: 0 5px 15px rgba(197, 166, 124, 0.2); /* Légère lueur dorée */
}

/* Hover sur la carte */
.card:hover img {
    transform: scale(1.05);
}

/* --- Transition Douce Footer --- */
.portfolio-page {
    padding-bottom: 120px; 
}

.card.hide {
    display: none !important;
}

#no-results {
    transition: opacity 0.3s ease;
}

#no-results.hide {
    display: none !important; /* Pour la logique JS */
}

/* Cache les cartes au-delà de la limite initiale */
.card.hidden-load {
    display: none !important;
}

.load-more-container.hide {
    display: none;
}

/* --- Style du bouton Voir Plus --- */
.load-more-container {
    text-align: center;
    margin-top: 60px;
    margin-bottom: 40px;
}

#load-more-btn {
    background: transparent;
    color: var(--text-white);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 16px 45px;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    cursor: pointer;
    position: relative;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow: hidden;
}

/* Petit liseré doré sur le côté gauche par défaut */
#load-more-btn::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 100%;
    background-color: var(--text-gold);
    transition: all 0.4s ease;
    z-index: -1;
}

/* Effet au survol */
#load-more-btn:hover {
    color: #000;
    border-color: var(--text-gold);
    letter-spacing: 5px; /* Élargissement élégant du texte */
}

#load-more-btn:hover::before {
    width: 100%; /* Le doré remplit le bouton */
}

/* Effet quand on clique (petit enfoncement) */
#load-more-btn:active {
    transform: scale(0.97);
}

/* Masquage fluide */
.load-more-container.hide {
    display: none;
    opacity: 0;
}

/* =========================================
   ADAPTATION MOBILE - RÉALISATIONS
   ========================================= */

@media (max-width: 992px) {
    /* 1. Header & Hero */
    .portfolio-page .hero {
        padding: 80px 20px 30px;
    }
    .portfolio-page .hero h1 {
        letter-spacing: 6px; /* Réduction pour éviter que le texte ne sorte de l'écran */
