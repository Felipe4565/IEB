/* --- Variables & Reset --- */
:root {
    --bg-dark: #0d0e0a;      /* Corrigé : était #121212 */
    --text-gold: #c5a67c;    /* Corrigé : était #c5a36b */
    --text-white: #f4f1ea;   /* Corrigé pour le beige luxe */
    --transition-smooth: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg-dark);    
    color: var(--text-white);
    font-family: 'Montserrat', sans-serif; /* Corrigé : était 'Inter' */}

/* --- Section Hero --- */
.portfolio-page .hero {
    text-align: center;
    padding: 100px 20px 40px;
}

.portfolio-page .hero .subtitle {
    font-size: 11px;
    text-transform: uppercase;
    color: var(--grey-muted);
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.portfolio-page .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 12px;
    font-weight: 300;
    text-transform: uppercase;
}

/* Harmonisation conteneur */
.portfolio-page .container {
    max-width: 1400px; 
}

/* --- Navigation & Filtres --- */
.filters-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    margin-bottom: 50px;
}

.filters {
    display: flex;
    gap: 25px; /* Un peu plus d'espace entre les mots pour le luxe */
}

.filters button {
    background: none;
    border: none;
    color: rgba(244, 241, 234, 0.4); /* Blanc cassé très discret */
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 2px;
    cursor: pointer;
    padding: 0 0 8px 0; /* Padding uniquement en bas */
    position: relative;
    transition: color 0.4s ease;
}

/* État Actif ET Survol : Couleur Gold */
.filters button.active, 
.filters button:hover {
    color: var(--text-gold);
}

/* Création de la ligne sous le bouton */
.filters button::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0; /* Caché par défaut */
    height: 1px;
    background: var(--text-gold);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* La ligne s'affiche en entier si actif OU au survol */
.filters button.active::after,
.filters button:hover::after {
    width: 100%;
}

.search-bar {
    position: relative;
    display: flex;
    align-items: center;
}

.search-bar input {
    /* Fond très légèrement éclairé pour rester en harmonie avec le header */
    background: rgba(255, 255, 255, 0.03); 
    /* Bordure fine et discrète */
    border: 1px solid rgba(255, 255, 255, 0.15); 
    color: #fff;
    padding: 10px 15px 10px 40px; /* Espace à gauche pour une icône loupe si besoin */
    border-radius: 4px;
    font-size: 13px;
    width: 280px;
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
}

/* Effet au clic (Focus) */
.search-bar input:focus {
    outline: none;
    border-color: var(--text-gold); /* Rappel du doré IEB */
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 15px rgba(197, 163, 107, 0.1); /* Lueur dorée très légère */
}

/* Style du texte d'aide (Placeholder) */
.search-bar input::placeholder {
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 1px;
}

/* Optionnel : Ajout d'une barre de séparation verticale avant la recherche comme sur le modèle */
.search-bar::before {
    content: "";
    height: 20px;
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
    margin-right: 20px;
    display: inline-block;
}

/* --- Grille de Portfolio --- */
.grid-portfolio {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 20px;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 30px 80px;
}

/* --- Cartes de Projet --- */
.card {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 6px; 
    background-color: #1a1a1a;
    
    transform: translateZ(0);
    will-change: opacity; 
    transition: opacity 0.25s ease-out; 
}

.card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
}

.card-overlay {
    position: absolute;
    inset: 0;
    padding: 25px;
    /* On assombrit plus fort le bas pour faire ressortir le blanc */
    background: linear-gradient(to top, 
        rgba(0, 0, 0, 0.9) 0%, 
        rgba(0, 0, 0, 0.5) 35%, 
        rgba(0, 0, 0, 0.1) 60%,
        transparent 100%);
