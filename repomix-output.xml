    width: 100%;
    min-height: 500px; /* Ajuste selon ton besoin */
    border: 1px solid rgba(197, 166, 124, 0.1);
    background: #0d0e0a;
    overflow: hidden; /* INDISPENSABLE pour le zoom */
    border-radius: 4px;
}

/* --- Conteneur de Zoom --- */
#map-zoom-container {
    width: 100%;
    height: 100%;
    position: relative;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    cursor: grab;
}

#map-zoom-container:active {
    cursor: grabbing;
}

.map-base-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0.7) contrast(1.1) grayscale(0.3);
    opacity: 0.7;
    transition: opacity 0.5s ease, filter 0.5s ease;
    display: block;
}

/* Éclairage de la carte quand on interagit ou qu'un point est actif */
.map-inner:hover .map-base-img,
#map-zoom-container[style*="scale(2"] .map-base-img {
    opacity: 1;
    filter: brightness(0.9) contrast(1.2) grayscale(0.1);
}

/* --- Points (Hotspots) --- */
.map-hotspot {
    position: absolute;
    width: 16px;
    height: 16px;
    background-color: var(--gold-accent);
    border-radius: 50%;
    z-index: 10;
    cursor: pointer;
    box-shadow: 0 0 15px var(--gold-glow);
    transition: transform 0.3s ease, background-color 0.3s ease;
    /* On s'assure que le point est bien centré sur ses coordonnées */
    margin-left: -8px; 
    margin-top: -8px;
}

/* État actif (quand on a cliqué) */
.map-hotspot.active {
    background-color: #fff;
    box-shadow: 0 0 20px #fff, 0 0 30px var(--gold-accent);
    transform: scale(1.2); /* On compense le zoom parent */
    border: 2px solid var(--gold-accent);
}

.map-hotspot:hover {
    transform: scale(1.4);
    background-color: #fff;
}

.map-hotspot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 45px; /* L'utilisateur peut cliquer jusqu'à 20px à côté du point */
    height: 45px;
    background: transparent; /* Reste invisible */
    border-radius: 50%;
}

/* Animation de pulsation */
.map-hotspot::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100%; height: 100%;
    border: 1px solid var(--gold-accent);
    border-radius: 50%;
    animation: hotspot-pulse 2.5s infinite;
    pointer-events: none;
}

@keyframes hotspot-pulse {
    0% { width: 14px; height: 14px; opacity: 1; }
    100% { width: 45px; height: 45px; opacity: 0; }
}

/* --- Ajustement des points lors du Zoom --- */
/* Pour éviter que les points deviennent gigantesques quand on scale la carte */
#map-zoom-container[style*="scale"] .map-hotspot {
    transform: scale(0.6);
}
#map-zoom-container[style*="scale"] .map-hotspot.active {
    transform: scale(0.8);
}

/* --- Fiche Descriptive sous la carte --- */
.location-info-card {
    margin-top: 25px;
    padding: 30px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0.03), transparent);
    border: 1px solid rgba(197, 166, 124, 0.1);
    border-left: 3px solid var(--gold-accent);
    min-height: 140px;
    transition: all 0.5s ease;
    border-radius: 0 4px 4px 0;
}

.location-info-card h3 {
    color: var(--gold-accent);
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
    font-weight: 600;
}

.location-info-card p {
    font-size: 0.95rem;
    color: var(--light-beige);
    opacity: 0.9;
    margin-bottom: 8px;
    line-height: 1.5;
}

.gold-subtitle {
    font-style: italic;
    color: var(--gold-accent) !important;
    margin-top: 15px;
    display: block;
    font-size: 0.9rem;
}

/* --- Utilitaires --- */
.map-overlay-gradient {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle, transparent 40%, rgba(13, 14, 10, 0.8) 110%);
    pointer-events: none;
    z-index: 5;
}

.hide { 
    display: none !important; 
}

/* Animation d'entrée pour le contenu info */
#info-content:not(.hide) {
    animation: fadeInSlide 0.6s ease forwards;
}

@keyframes fadeInSlide {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

.map-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--light-beige);
    text-decoration: none;
    opacity: 0.8;
    margin-bottom: 8px;
    transition: all 0.3s ease;
    border-bottom: 1px border transparent;
}

.map-link i {
    color: var(--gold-accent);
    margin-right: 8px;
}

.map-link:hover {
    opacity: 1;
    color: var(--gold-accent);
    transform: translateX(5px); /* Petit décalage au survol */
}

/* --- Détails Formulaire --- */
.gold-line {
    width: 40px;
    height: 2px;
    background: #c5a67c;
    margin: 15px 0 35px 0;
}

.premium-dark-form input, 
.premium-dark-form textarea {
    width: 100%;
    margin-bottom: 20px;
    padding: 18px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(197, 166, 124, 0.15);
    color: white;
    font-size: 0.95rem;
}

.btn-gold {
    width: 100%;
    padding: 20px;
    background: var(--gold-accent);
    color: #1a1c14;
    border: none;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.4s ease;
    margin-top: 10px;
}

.btn-gold:hover {
    background: #fff; /* Switch vers le blanc pour un contraste luxe */
    letter-spacing: 5px; /* S'étire légèrement */
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
}

/* Lissage du scroll pour l'élégance */
html {
    scroll-behavior: smooth;
}

/* Amélioration du contraste typographique */
h1, h2 {
    letter-spacing: -0.02em; /* Pour un look plus éditorial/magazine */
}

/* Suppression des bordures trop nettes */
.image-box, .floating-contact-card, .map-inner {
    border: 1px solid rgba(197, 166, 124, 0.08) !important;
}

/* =========================================
   ADAPTATION MOBILE & SMARTPHONES
   ========================================= */

/* Sécurité globale pour éviter l'espace vide à droite */
html, body {
    max-width: 100%;
    overflow-x: hidden;
    width: 100%;
}

@media (max-width: 992px) {
    
    /* 1. Suppression du Meuble Interactif (Trop complexe sur mobile) */
    .furniture-experience {
        display: none !important;
    }

    /* 2. Structure Générale */
    .container {
        width: 92%;
    }

    /* 3. Hero Section (Accueil) */
    .hero-premium {
        height: auto;
        min-height: 450px;
        padding: 60px 0;
    }

    .main-hero-text h1 {
        font-size: 2.2rem;
        margin-bottom: 15px;
    }

    .hero-btns {
        flex-direction: column; /* On empile les boutons */
        gap: 15px;
    }

    .btn-devis-solid {
        width: 100%;
        text-align: center;
    }

    /* 4. Grille de la Galerie (Index) */
    .gallery-grid {
        grid-template-columns: 1fr; /* Une seule colonne au lieu de trois */
        gap: 30px;
    }

    .image-box img {
        height: 300px;
    }

    /* 5. Section Contact & Map */
    .container-contact-wrapper {
        flex-direction: column; /* La carte passe sous le formulaire */
        gap: 40px;
    }

    .contact-column-form, .contact-column-map {
        width: 100%;
    }

    .floating-contact-card {
        padding: 30px 20px;
        max-width: 100%;
        box-shadow: none; /* On allège le design sur mobile */
    }

    .contact-column-map {
        height: 350px;
    }
    
    .map-inner {
        min-height: 350px;
    }

    /* 6. Ajustements des formulaires */
    .premium-dark-form input, 
    .premium-dark-form textarea {
        padding: 15px;
        font-size: 16px; /* Évite le zoom automatique sur iPhone */
    }
}

/* Ajustements spécifiques pour iPhone SE et petits écrans */
@media (max-width: 480px) {
    .main-hero-text h1 {
        font-size: 1.8rem;
    }
    
    .top-announcement p {
        letter-spacing: 3px;
        font-size: 0.6rem;
    }

    .gallery-intro h2 {
        font-size: 1.4rem;
    }
}
