        font-size: 0.85rem;
        letter-spacing: 1px;
        animation: slideIn 0.5s ease forwards, fadeOut 0.5s ease 3.5s forwards;
    }

    @keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }

    @keyframes fadeOut {
        from { opacity: 1; }
        to { opacity: 0; pointer-events: none; }
    }
