<file path="src/css/avis.css">
/* --- VARIABLES --- */
:root {
    --gold: #c5a67c;     /* Corrigé : était #C5A059 */
    --dark-bg: #0d0e0a;   /* Corrigé : était #0A0A0A */
    --green-bg: #0E1A11;
    --text-light: #f4f1ea; /* Corrigé : était #E5E5E5 */
}

.page-avis {
    background-color: var(--dark-bg);
    color: var(--text-light);
    font-family: 'Montserrat', sans-serif;
}

.container { max-width: 1400px; margin: 0 auto; padding: 0 20px; }

/* --- SECTION 1 : HERO (VERSION STABLE & AFFICHAGE COMPLET) --- */
.hero-score {
    position: relative;
    padding: 160px 0 100px; 
    text-align: center;
    background: 
        linear-gradient(to bottom, rgba(10, 10, 10, 0.4) 0%, #0A0A0A 100%), 
        url('../assets/img/avis/matiere.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    overflow: hidden;
}

.hero-score .container {
    position: relative;
    z-index: 2;
    animation: fadeInLuxeSimple 1.2s ease-out forwards;
}

.serif-gold {
    font-family: 'Playfair Display', serif;
    color: #C5A059;
    
    font-size: clamp(2rem, 3.5vw, 2.5rem); /* Au lieu de (1.6rem, 3vw, 2.2rem) */
    
    letter-spacing: 5px; /* Au lieu de 7px */
    
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 auto 30px; 
    display: block;
    text-rendering: optimizeLegibility;
    
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4));
}

/* LE CHIFFRE 5.0 - CORRIGÉ POUR ÉVITER LA COUPURE */
.score-number {
    font-family: 'Playfair Display', serif;
    font-size: clamp(7rem, 12vw, 10rem);
    font-weight: 700;
    /* On augmente le line-height pour ne pas couper le haut/bas des chiffres */
    line-height: 1.1; 
    margin: 0;
    /* On ajoute un léger padding vertical pour laisser de la place au dégradé */
    padding: 10px 0;
    
    background: linear-gradient(180deg, #FFFFFF 30%, #c5a67c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    
    /* On utilise drop-shadow sur le parent ou on réduit l'intensité pour éviter les artefacts */
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.8));
    display: inline-block; /* Crucial pour que le padding et le clip fonctionnent ensemble */
}

/* Étoiles : On ajuste la marge haute puisque le line-height du chiffre a augmenté */
.stars-row.unifie {
    display: block;
    color: #C5A059;
    font-size: 1.1rem; 
    letter-spacing: 25px; 
    margin-top: 30px; /* Réduit car le line-height du chiffre est plus grand */
    margin-bottom: 80px; 
    filter: drop-shadow(0 0 15px rgba(197, 160, 89, 0.4));
}

/* --- LE BADGE GOOGLE (STABLE) --- */
.google-badge-link {
    text-decoration: none !important;
    display: inline-flex;
    transition: transform 0.4s ease;
    outline: none;
}

.google-badge-link:hover {
    transform: translateY(-5px);
}

.google-badge {
    position: relative;
    overflow: hidden; 
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px 25px;
    border: 1px solid rgba(197, 160, 89, 0.25);
    border-radius: 50px;
    background: rgba(10, 10, 10, 0.5);
    backdrop-filter: blur(15px);
}

.google-badge img { 
    width: 20px !important;  
    height: 20px !important; 
    object-fit: contain;     
    flex-shrink: 0;         
    filter: brightness(1.1);
}

.google-badge span {
    font-size: 0.8rem;
    letter-spacing: 1px;
    color: #E5E5E5 !important;
    white-space: nowrap;
}

.google-badge strong {
    color: #C5A059 !important;
    text-transform: uppercase;
}

.google-badge::after {
    content: "";
    position: absolute;
    top: 0; left: -100%;
    width: 60%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    transform: skewX(-25deg);
    transition: 0.6s;
}

.google-badge-link:hover .google-badge::after {
    left: 150%;
}

@keyframes fadeInLuxeSimple {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* --- SECTION AVANT/APRÈS (VERSION FINALE & RÉPARÉE) --- */
.section-transformation {
    padding: 100px 0;
    background: #0E1A11; /* Ton vert signature sombre */
}

/* Le titre de la section en haut */
.serif-gold {
    font-family: 'Playfair Display', serif;
    color: #C5A059;
    font-size: 2.2rem;
    margin-bottom: 40px;
    text-align: left;
}

/* LA CARTE : On ramène le cadre et l'ombre profonde */
.comparison-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    background: #000;
    border: 1px solid rgba(197, 160, 89, 0.2);
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
    overflow: hidden; /* Important pour que les images ne débordent pas */
}

/* LE SLIDER : Force une hauteur fixe pour afficher les images en fond */
.comparison-slider {
    position: relative;
    width: 100%;
    height: 550px; /* HAUTEUR CRITIQUE POUR VOIR LES IMAGES */
    overflow: hidden;
    cursor: col-resize;
}

.img-before, .img-after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover; /* L'image remplit tout le bloc */
    background-position: center;
    background-repeat: no-repeat;
}

/* L'image "Avant" est par-dessus */
.img-before {
    width: 50%; 
    z-index: 2;
}

.img-after {
    z-index: 1; /* L'image après est toujours en fond */
}

/* Le curseur visible (ligne dorée + bouton) */
.slider-line {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: 2px;
    background: #C5A059;
    z-index: 5;
    pointer-events: none;
    transform: translateX(-50%);
}

.slider-line::after {
    content: "⟷";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: #C5A059;
    color: #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    box-shadow: 0 0 20px rgba(197, 160, 89, 0.5);
}

/* Le curseur invisible par-dessus pour capter le clic */
.slider-handle {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: col-resize;
    z-index: 10;
    margin: 0;
}

/* Labels Avant/Après */
.label-before, .label-after {
    position: absolute; bottom: 20px;
    background: rgba(0,0,0,0.6);
    padding: 5px 15px;
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 2px;
    color: #C5A059;
    z-index: 4;
}
.label-before { left: 20px; }
.label-after { right: 20px; }

/* LE BLOC DE TEXTE (AÉRÉ ET STRUCTURÉ) */
.transformation-text {
    padding: 60px; /* Plus d'espace pour respirer */
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
}

.transformation-header {
    margin-bottom: 40px;
}

.title-section-unifie {
    font-family: 'Playfair Display', serif;
    font-size: 0.9rem;
    color: #C5A059;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.client-name {
    font-size: 1.8rem;
    color: #FFF;
    font-weight: 600;
}

.client-project {
    font-size: 0.8rem;
    color: rgba(229, 229, 229, 0.7);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* La citation avec la barre verticale dorée */
.main-quote {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    line-height: 1.7;
    font-style: italic;
    color: #E5E5E5;
    padding-left: 25px;
    border-left: 1px solid #C5A059;
    margin: 0 0 30px 0;
}

.signature-client {
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #C5A059;
    font-weight: 600;
}

/* --- TOUS LES AVIS --- */
.all-reviews { padding: 100px 0; }

.reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 60px;
}

.btn-gold-outline {
    border: 1px solid var(--gold);
    color: var(--gold);
    padding: 12px 30px;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
    transition: 0.3s;
}

.btn-gold-outline:hover { background: var(--gold); color: #000; }

.reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.review-card {
    background: rgba(255,255,255,0.03);
    padding: 40px;
    border: 1px solid rgba(255,255,255,0.05);
}

.review-card .stars { color: var(--gold); margin-bottom: 20px; }

.review-author {
    display: block;
    margin-top: 20px;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--gold);
}


.btn-small {
    padding: 8px 18px;
    font-size: 0.65rem;
    margin-top: 20px;
    display: inline-block;
    opacity: 0.8;
}

.btn-small:hover {
    opacity: 1;
}

.review-card:not(.has-images) .btn-small {
    display: none;
}

/* =========================================
   ADAPTATION MOBILE - PAGE AVIS (V2 CORRIGÉE)
   ========================================= */

@media (max-width: 992px) {
    /* 1. HERO & SCORE - Ajustements pour éviter les débordements */
    .hero-score {
        padding: 100px 0 60px;
        background-attachment: scroll; /* Vital pour mobile */
    }

    .score-number {
        font-size: clamp(5rem, 15vw, 7rem); /* Réduit pour ne pas saturer l'écran */
        line-height: 1;
    }

    .stars-row.unifie {
        letter-spacing: 15px; /* Réduction de l'espace entre étoiles */
        margin-bottom: 40px;
    }

    /* 2. FIX GOOGLE BADGE (Empêche de dépasser) */
    .google-badge-link {
        display: inline-block;
        max-width: 95%; /* Sécurité pour ne jamais toucher les bords */
        margin: 0 auto;
    }

    .google-badge {
        padding: 10px 20px;
        flex-wrap: nowrap; /* Garde l'icône et le texte alignés */
        gap: 10px;
        justify-content: center;
    }

    .google-badge span {
        font-size: 0.7rem; /* Plus petit pour tenir sur une ligne */
        white-space: normal; /* Permet le retour à la ligne si vraiment trop étroit */
        text-align: left;
    }

    /* 3. SUPPRESSION TOTALE DE LA SECTION MÉTAMORPHOSE */
    /* On cible la classe principale de la section pour la faire disparaître */
    .section-transformation {
        display: none !important;
    }

    /* 4. SECTION TOUS LES AVIS */
    .all-reviews {
        padding: 60px 0;
    }

    .reviews-header {
        flex-direction: column;
        gap: 25px;
        text-align: center;
        margin-bottom: 40px;
    }

    .reviews-grid {
        grid-template-columns: 1fr; /* Un avis par ligne */
        gap: 20px;
        padding: 0 10px;
    }

    .review-card {
        padding: 30px 20px;
    }

    /* 5. BOUTON "LAISSER UN AVIS" */
    .btn-gold-outline {
        width: 100%;
        display: block;
        text-align: center;
    }
}

/* Optimisations extrêmes (iPhone SE / Écrans < 400px) */
@media (max-width: 400px) {
    .serif-gold {
        font-size: 1.5rem !important;
        letter-spacing: 3px;
    }

    .score-number {
        font-size: 5rem;
    }

    .google-badge span {
        font-size: 0.65rem;
    }
    
    .google-badge img {
        width: 16px !important;
        height: 16px !important;
    }
}
