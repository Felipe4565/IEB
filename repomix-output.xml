    color: #1a1c14; /* LE TEXTE devient sombre ici pour être lisible sur le Gold */
}

.btn-contact-pill:hover::after {
    transform: scaleX(1); /* Le fond Gold se déploie */
    transform-origin: left;
}

/* =========================================
    HEADER RESPONSIVE AMÉLIORÉ
   ========================================= */

/* Verrouillage global anti-scroll horizontal */
html, body {
    max-width: 100% !important;
    overflow-x: hidden !important;
    position: relative;
    width: 100%;
}

/* Le Voile Sombre */
.menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
}

.menu-overlay.active {
    opacity: 1;
    visibility: visible;
}

.menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    margin-left: 20px;
    z-index: 3000;
}

.menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--gold-accent);
    transition: all 0.3s cubic-bezier(0.645, 0.045, 0.355, 1);
}

@media (max-width: 992px) {
    .main-header { 
        height: 80px; 
        display: flex;
        align-items: center;
        width: 100%;
    }

    .main-header .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 15px;
        flex-wrap: nowrap; 
        width: 100%;       
        box-sizing: border-box;
    }

    .logo { 
        flex: 0 1 auto; 
        min-width: 0;   
    }

    .logo img { 
        height: 35px !important; 
        width: auto;
        object-fit: contain;
    }

    .menu-toggle { display: flex; }

    /* Suppression des séparateurs horizontaux sur mobile */
    .nav-menu li:not(:last-child)::after { display: none; }

    /* --- PANNEAU LATÉRAL CORRIGÉ --- */
    .nav-menu {
        position: fixed;
        top: 0;
        right: -100%;
        width: 85%;
        max-width: 400px;
        height: 100vh;
        background: #0d0e0a; 
        padding: 120px 40px 40px;
        z-index: 2000;
        
        /* CORRECTIF : On utilise flex avec une direction colonne pour ranger le menu */
        display: flex !important; 
        flex-direction: column !important; /* Force les liens à s'empiler verticalement */
        align-items: flex-start !important; /* Aligne le texte à gauche */
        
        visibility: hidden; 
        transition: right 0.5s cubic-bezier(0.77, 0.2, 0.05, 1.0), visibility 0.5s;
        
        pointer-events: none;
        overflow-y: auto;
        box-sizing: border-box;
    }

    .nav-menu.active { 
        right: 0; 
        visibility: visible; 
        pointer-events: auto; 
    }

    /* On s'assure que la liste (ul) à l'intérieur ne crée pas de bazar */
    .nav-menu ul {
        display: flex !important;
        flex-direction: column !important; /* Force l'empilement vertical des <li> */
        width: 100%;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .nav-menu li {
        width: 100%;
        display: block !important; /* Chaque item prend sa propre ligne */
    }

    .nav-menu.active li {
        opacity: 1;
        transform: translateX(0);
        transition-delay: calc(0.1s * var(--i));
    }

    .nav-menu a {
        display: block;
        padding: 18px 0;
        font-size: 1.1rem;
        width: 100%;
        opacity: 1;
        letter-spacing: 2px;
    }

    /* Animation du bouton burger en X */
    .menu-toggle.active span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .menu-toggle.active span:nth-child(2) { opacity: 0; transform: translateX(20px); }
    .menu-toggle.active span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    .header-actions {
        display: flex !important;
        align-items: center;
        flex-shrink: 0; 
        margin-left: 10px;
        gap: 8px;          
    }

    .btn-contact-pill { 
        padding: 6px 10px !important; 
        font-size: 0.6rem !important; 
        white-space: nowrap;          
    }
}

/* Optimisation pour les très petits écrans */
@media (max-width: 340px) {
    .btn-contact-pill { display: none !important; } 
}
