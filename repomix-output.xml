    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
}

.card-overlay span {
    font-size: 10px;
    text-transform: uppercase;
    color: var(--text-gold); /* Ton doré */
    letter-spacing: 2px;
    margin-bottom: 5px;
    font-weight: 600;
    /* Ombre portée subtile pour détacher du fond */
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
