<file path="src/css/laisser_avis.css">
:root {
    --gold: #c5a67c;            /* Corrigé : était #C5A059 */
    --dark-ieb: #0d0e0a;        /* Corrigé pour cohérence fond principal */
    --gold-light: rgba(197, 166, 124, 0.2);
    --gold-glow: rgba(197, 166, 124, 0.4);
}

/* Fond de la section */
.section-form-avis {
    padding: 100px 20px;
    background: var(--dark-ieb);
    min-height: 100vh;
    display: flex;
    align-items: center; /* Centrage vertical */
    justify-content: center; /* Centrage horizontal */
    font-family: 'Montserrat', sans-serif;
}

/* C'est ce bloc qui remet le formulaire au milieu */
.section-form-avis .container {
    width: 100%;
    max-width: 1400px;
    display: flex;
    flex-direction: column;
    align-items: center; /* Aligne le contenu (nav + wrapper) au centre */
    margin: 0 auto;
}

/* --- NAVIGATION RETOUR --- */
.section-form-avis .form-navigation {
    width: 100%;
    max-width: 750px; /* Aligné sur la largeur du formulaire */
    margin-bottom: 25px;
    text-align: left;
}

.section-form-avis .btn-back {
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 2px;
    transition: 0.4s ease;
}

.section-form-avis .btn-back:hover { color: var(--gold); }
.section-form-avis .btn-back .icon { margin-right: 12px; transition: transform 0.3s; }
.section-form-avis .btn-back:hover .icon { transform: translateX(-8px); }

/* --- CONTENEUR FORMULAIRE (GLASSMORPHISM) --- */
.section-form-avis .form-wrapper {
    max-width: 750px;
    width: 100%;
    background: var(--form-bg-ieb);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    padding: 60px;
    border: 1px solid var(--gold-light);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6);
    position: relative;
    border-radius: 4px;
}

.section-form-avis .form-wrapper::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

/* --- TYPOGRAPHIE --- */
.section-form-avis .form-header { text-align: center; margin-bottom: 50px; }
.section-form-avis .serif-gold { 
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem; 
    color: #FFF; 
    margin-bottom: 10px; 
}
.section-form-avis .form-subtitle {
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.75rem;
}

/* --- NOTES & ÉTOILES --- */
.section-form-avis .rating-select { text-align: center; margin-bottom: 40px; }
.section-form-avis .label-gold {
    display: block;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    margin-bottom: 10px;
}

.section-form-avis .rating-text {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.section-form-avis .stars-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    gap: 15px;
    font-size: 2.5rem;
}

.section-form-avis .stars-input input { display: none; }
.section-form-avis .stars-input label { 
    color: rgba(255, 255, 255, 0.05); 
    cursor: pointer; 
    transition: 0.3s; 
}

.section-form-avis .stars-input label:hover,
.section-form-avis .stars-input label:hover ~ label,
.section-form-avis .stars-input input:checked ~ label { 
    color: var(--gold); 
    text-shadow: 0 0 20px var(--gold-glow);
}

/* --- TAGS --- */
.section-form-avis .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0 40px;
}

.section-form-avis .tag {
    padding: 10px 20px;
    border: 1px solid rgba(197, 160, 89, 0.3);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: 0.4s;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 50px;
}

.section-form-avis .tag:hover, .section-form-avis .tag.active { 
    border-color: var(--gold);
    color: #FFF;
}

.section-form-avis .tag.active { 
    background: var(--gold); 
    color: #000; 
    font-weight: 700; 
}

/* --- INPUTS --- */
.section-form-avis .input-group { margin-bottom: 45px; position: relative; }

.section-form-avis .avis-form input[type="text"], 
.section-form-avis .avis-form textarea {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 15px 0;
    color: #FFF;
    font-family: inherit;
    font-size: 1rem;
    outline: none;
    transition: 0.4s;
    resize: none; /* Empeche de redimensionner manuellement */
}

.section-form-avis .input-group::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 1px;
    background: var(--gold);
    transition: 0.5s ease;
}

.section-form-avis .input-group:focus-within::after { width: 100%; }

/* --- UPLOAD --- */
.section-form-avis .file-upload {
    margin: 40px 0;
    border: 1px dashed var(--gold-light);
    padding: 40px 20px;
    text-align: center;
    border-radius: 8px;
}

.section-form-avis .file-label { cursor: pointer; color: var(--gold); }

/* --- BOUTON SUBMIT --- */
.section-form-avis .btn-submit-gold {
    width: 100%;
    background: var(--gold);
    color: #000;
    border: none;
    padding: 22px;
    text-transform: uppercase;
    letter-spacing: 5px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.6s;
    position: relative;
}

.section-form-avis .btn-submit-gold:hover { background: #FFF; letter-spacing: 7px; }

/* Animation loading */
.section-form-avis .btn-submit-gold.sending {
    pointer-events: none;
    color: transparent;
}
.section-form-avis .btn-submit-gold.sending::after {
    content: "Envoi...";
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    color: #000;
    animation: fadeInOut 1.5s infinite;
}

@keyframes fadeInOut {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

/* --- NOUVEAU SYSTÈME DE MINIATURES MULTIPLES --- */

/* Conteneur des vignettes */
#thumbnails-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 25px;
    justify-content: center;
}

/* Chaque bloc photo */
.thumbnail-item {
    position: relative;
    width: 90px;
    height: 90px;
    animation: fadeIn thumbnailScale 0.4s ease-out forwards;
}

.thumbnail-item img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Recadre l'image proprement en carré */
    border: 1px solid var(--gold-light);
    border-radius: 4px;
    padding: 3px;
    background: rgba(255, 255, 255, 0.05);
    transition: border-color 0.3s;
}

.thumbnail-item:hover img {
    border-color: var(--gold);
}

/* La petite croix rouge de suppression */
.remove-thumbnail {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #ff4d4d;
    color: white;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    transition: all 0.2s ease;
}

.remove-thumbnail:hover {
    background: #cc0000;
    transform: scale(1.2);
}

/* Animation d'apparition des photos */
@keyframes thumbnailScale {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
}

/* --- COMPTEUR DE CARACTÈRES (Pour la sécurité) --- */
#char-count {
    text-align: right;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s;
}
